{
	"name": "campusphere",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun --bun vite build",
		"start": "bun ./build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun --bun drizzle-kit migrate",
		"db:studio": "bun --bun drizzle-kit studio",
		"db:seed": "bun run scripts/seed.ts",
		"db:seed-admin": "bun run scripts/seed-admin.ts",
		"db:reconcile": "bun run scripts/reconcile-counts.ts",
		"db:prune-media": "bun run scripts/prune-media.ts",
		"test:db": "vitest run --config vitest.db.config.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@types/sanitize-html": "^2.16.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1161.0",
		"@aws-sdk/s3-request-presigner": "^3.1161.0",
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/lora": "^5.3.0",
		"@neon/config": "^1.10.0",
		"@neon/env": "^1.6.8",
		"@node-rs/argon2": "^2.2.2",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.1",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.66.0",
		"marked": "^18.1.2",
		"motion": "^14.9.0",
		"ogl": "^1.0.11",
		"pg": "^8.23.1",
		"sanitize-html": "^2.18.1",
		"shadcn": "^4.23.0",
		"sharp": "^0.35.5",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	}
}
