# Copy to .env.local and fill in. Never commit real values.
# Neon values are written automatically by `neon deploy` / `neon env pull`.

# --- Neon Postgres ---
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Neon Object Storage (bucket "assets", private) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Neon Function (smoke test only) ---
NEON_FUNCTION_HELLO_BASE_URL=

# --- Anonymity and abuse protection ---
# Random secret, at least 32 characters. Generate with: openssl rand -base64 48
# Rotating it unlinks all existing anonymous tokens (people lose edit rights and can support again).
ANON_SECRET=

# Cloudflare Turnstile. Leave both empty in development to bypass the bot check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- First administrator (read only by `bun run db:seed-admin`, not by the app) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Production (adapter-bun) ---
# Public URL of the site, required behind a proxy so CSRF origin checks pass.
# ORIGIN=https://campusphere.example.edu
